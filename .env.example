# Categoria Service (services/categoria-service)
CATEGORIA_SERVICE_PORT=8085
CATEGORIA_DB_HOST=localhost
CATEGORIA_DB_PORT=5432
CATEGORIA_DB_NAME=pos_tienda
CATEGORIA_DB_USER=postgres
# Valor por defecto solo para desarrollo local/Docker. Cambialo por una
# contraseña real antes de desplegar en un entorno accesible desde fuera.
CATEGORIA_DB_PASSWORD=postgres

# Producto Service (services/producto-service)
PRODUCTO_SERVICE_PORT=8086
PRODUCTO_DB_HOST=localhost
PRODUCTO_DB_PORT=5432
PRODUCTO_DB_NAME=tienda_productos
PRODUCTO_DB_USER=postgres
# Idem: valor por defecto solo para desarrollo local/Docker.
PRODUCTO_DB_PASSWORD=postgres

# API Gateway (services/api-gateway)
GATEWAY_PORT=8080
CATEGORIA_SERVICE_URL=http://localhost:8085
PRODUCTO_SERVICE_URL=http://localhost:8086
CORS_ALLOWED_ORIGIN=*

# --- Docker Compose (solo aplican con `docker compose up`) ---
#
# IMPORTANTE: CATEGORIA_DB_PASSWORD y PRODUCTO_DB_PASSWORD (arriba) NO
# pueden quedar vacias para Docker: la imagen oficial de postgres se
# niega a arrancar sin contraseña de superusuario. Ya traen un valor
# por defecto ("postgres") para que `docker compose up` funcione sin
# pasos extra; cambialo si vas a exponer el stack fuera de tu maquina.

# Puerto publicado en el host para el API Gateway (el contenedor
# siempre escucha en 8080 puertas adentro; esto es el mapeo de host).
GATEWAY_HOST_PORT=8080

# Puerto publicado en el host para el frontend (nginx escucha en 80
# puertas adentro).
FRONTEND_HOST_PORT=3000

# URL del API Gateway tal como la vera el NAVEGADOR del usuario (se usa
# para regenerar frontend/js/config.js al arrancar el contenedor
# frontend). Si cambias GATEWAY_HOST_PORT, actualiza esto tambien.
GATEWAY_PUBLIC_URL=http://localhost:8080
